{
  "name": "otama-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Popcorn Time Android/iOS shell (Capacitor) around https://otama.antideploy.app",
  "scripts": {
    "sync": "cap sync",
    "android": "cap run android",
    "ios": "cap run ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#0b0b10' --splashBackgroundColor '#0b0b10' --splashBackgroundColorDark '#0b0b10'"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/ios": "^7.6.10"
  }
}
