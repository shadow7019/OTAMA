generator client {
  provider      = "prisma-client-js"
  // "windows" bundles the Windows query engine so the Electron desktop build
  // (cross-compiled on Linux / CI) ships a working Prisma+SQLite client.
  // "darwin-arm64" bundles the Apple Silicon query engine for the macOS DMG.
  binaryTargets = ["native", "windows", "darwin-arm64"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Registered viewer — every account owns a PRIVATE watch history and
// favorites list; no account can read another account's data.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String // scrypt$<salt>$<hash> (Node crypto, no native deps)
  createdAt    DateTime @default(now())

  sessions  Session[]
  history   WatchHistory[]
  favorites Favorite[]
}

// Server-side session (httpOnly cookie holds only a random opaque token).
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A saved item (movie / series / anime / raw torrent) — per-account
model Favorite {
  id        String   @id @default(cuid())
  kind      String // 'movie' | 'tv' | 'anime' | 'tpb'
  refId     String // imdb id, tvmaze id, or info hash
  title     String
  year      Int?
  poster    String?
  rating    Float?
  metaJson  String? // JSON blob with provider-specific payload (torrent options etc.)
  createdAt DateTime @default(now())
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, refId])
  @@index([createdAt])
  @@index([userId])
}

// Resume-playback history — per-account
model WatchHistory {
  id        String   @id @default(cuid())
  refId     String // imdb id / tvmaze id / info hash
  title     String
  poster    String?
  kind      String   @default("movie")
  infoHash  String
  fileIndex Int      @default(0)
  position  Float    @default(0) // seconds
  duration  Float?
  metaJson  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, refId])
  @@index([updatedAt])
  @@index([userId])
}

// Simple key/value app settings
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
